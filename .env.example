# Environment
ENVIRONMENT=development

# Server
SERVER_PORT=8080
SERVER_MODE=debug

# Host port published by the nginx container (container itself always listens on 80)
NGINX_HTTP_PORT=8081
# NGINX_HTTPS_PORT=8443

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clap
DB_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRY=7200
JWT_REFRESH_EXPIRY=604800
JWT_ISSUER=clap
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Authorization

# SMTP / MailHog (for host tools like: make test-smtp TO=...)
# Docker Compose API is wired to service "mailhog" automatically.
# UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@clap.local
SMTP_FROM_NAME=Clap
SMTP_USE_TLS=false

# Storage (local disk by default; set provider=r2 + R2_* for Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_LOCAL_PUBLIC_URL=/uploads
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Stripe (browser checkout via Stripe Checkout Session)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_APP_URL_SCHEME=smartklap

# Firebase Admin SDK (FCM). Required to send chant countdown push notifications.
# Use either the JSON contents or a path to the service-account file.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS_FILE=/path/to/firebase-adminsdk.json
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-adminsdk.json

# Google Sign-In (comma-separated OAuth client IDs allowed as ID token `aud`).
# Include the Web client ID used by the mobile SDK, plus iOS/Android IDs.
# GOOGLE_CLIENT_IDS=123.apps.googleusercontent.com,456.apps.googleusercontent.com
