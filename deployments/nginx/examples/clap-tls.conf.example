# HTTPS front end for the Clap API.
#
# To enable:
#   1. Put fullchain.pem / privkey.pem under deployments/nginx/certs/
#   2. Uncomment the certs volume and the NGINX_HTTPS_PORT mapping in docker-compose.yml
#   3. Copy this file to deployments/nginx/conf.d/clap-tls.conf and replace
#      api.example.com with the real domain
#   4. In deployments/nginx/conf.d/clap.conf, replace the `location /` block of the
#      port 80 server with a redirect to https (keeping /nginx-health and the ACME
#      challenge location reachable over plain http)
#   5. docker compose exec nginx nginx -t && docker compose exec nginx nginx -s reload

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name api.example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;
    ssl_stapling              on;
    ssl_stapling_verify       on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    nosniff always;
    add_header X-Frame-Options           DENY    always;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";
    proxy_http_version 1.1;

    location = /health {
        access_log off;
        proxy_pass http://clap_api;
    }

    location = /api/v1/realtime/ws {
        proxy_pass http://clap_api;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin            $http_origin;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_buffering    off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        limit_conn ws_conn 20;
    }

    location ^~ /api/v1/auth/ {
        proxy_pass http://clap_api;
        limit_req  zone=auth_limit burst=10 nodelay;
    }

    location / {
        proxy_pass http://clap_api;
        limit_req  zone=api_limit burst=60 nodelay;
    }
}

